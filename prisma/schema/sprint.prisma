model Sprint {
  id        String    @id @default(uuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
